# Copy to .env.local and fill with your Supabase project values.
# Project Settings -> API in the Supabase dashboard.

# These are safe to expose to the browser (anon key is RLS-protected).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses row-level security, so keep it secret and never
# expose it to the browser. Used server-side for vehicle photo uploads.
SUPABASE_SERVICE_ROLE_KEY=
